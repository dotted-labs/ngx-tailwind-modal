    "@typescript-eslint/utils": "^8.57.0",
    "daisyui": "^5.0.35",
    "eslint": "^8.57.0",
    "jasmine-core": "~5.1.1",
    "karma": "~6.4.2",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
